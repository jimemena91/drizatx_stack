#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
  pwd
)"

export DRIZATX_DEPLOY_ROOT="$SCRIPT_DIR"

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

# shellcheck source=lib/config.sh
source "$SCRIPT_DIR/lib/config.sh"

# shellcheck source=lib/security.sh
source "$SCRIPT_DIR/lib/security.sh"

# shellcheck source=lib/prepare.sh
source "$SCRIPT_DIR/lib/prepare.sh"

# shellcheck source=lib/deploy.sh
source "$SCRIPT_DIR/lib/deploy.sh"

usage() {
  cat <<'USAGE'
DrizaTx Deployment Framework

Uso:
  ./scripts/deploy/drizatx-deploy inspect <cliente>
  ./scripts/deploy/drizatx-deploy prepare <cliente>
  ./scripts/deploy/drizatx-deploy deploy <cliente> <manifest>
  ./scripts/deploy/drizatx-deploy deploy --dry-run <cliente> <manifest>
  ./scripts/deploy/drizatx-deploy list
  ./scripts/deploy/drizatx-deploy help

Comandos disponibles:

  inspect <cliente>
      Carga y valida la configuración.
      Ejecuta un preflight completo de solo lectura:
      repositorio, Compose, contenedores, red y puertos.
      No modifica archivos, imágenes, contenedores ni datos.

  prepare <cliente>
      Ejecuta el preflight, protege la imagen activa,
      construye una imagen frontend versionada,
      inicia un preview temporal y valida su respuesta HTTP.
      No reemplaza el frontend productivo.

  deploy <cliente> <manifest>
      Despliega exclusivamente una imagen validada por prepare.
      Requiere el manifest exacto, recrea solo el frontend,
      valida HTTP y ejecuta rollback automático si falla.

  deploy --dry-run <cliente> <manifest>
      Ejecuta las mismas validaciones previas del despliegue real,
      muestra el plan de ejecución y termina antes de modificar
      imágenes, contenedores o servicios productivos.

  list
      Lista las configuraciones de clientes disponibles.

  help
      Muestra esta ayuda.

Ejemplos:

  ./scripts/deploy/drizatx-deploy inspect cruzverde
  ./scripts/deploy/drizatx-deploy prepare cruzverde
  ./scripts/deploy/drizatx-deploy deploy cruzverde /ruta/manifest.env
  ./scripts/deploy/drizatx-deploy deploy --dry-run cruzverde /ruta/manifest.env
  ./scripts/deploy/drizatx-deploy inspect martinez
  ./scripts/deploy/drizatx-deploy list

Prepare no reemplaza producción.
Deploy requiere una preparación validada y posee rollback automático.
USAGE
}

list_clients() {
  local config_file

  drizatx_section "CLIENTES CONFIGURADOS"

  for config_file in "$SCRIPT_DIR"/clients/*.conf; do
    [ -e "$config_file" ] || continue

    [ "$(basename "$config_file")" = "template.conf" ] &&
      continue

    basename "$config_file" .conf
  done
}

inspect_client() {
  local client_key="${1:-}"

  [ -n "$client_key" ] ||
    drizatx_fail "Debe indicar el cliente"

  drizatx_require_command git
  drizatx_require_command docker

  drizatx_load_client_config "$client_key"
  drizatx_validate_client_config

  drizatx_section "CONFIGURACIÓN VALIDADA"
  drizatx_print_client_config

  drizatx_run_preflight

  drizatx_section "RESULTADO"
  echo "Inspección terminada correctamente."
  echo "No se modificaron archivos, imágenes, contenedores ni datos."
}

prepare_client() {
  local client_key="${1:-}"

  [ -n "$client_key" ] ||
    drizatx_fail "Debe indicar el cliente"

  drizatx_require_command git
  drizatx_require_command docker
  drizatx_require_command curl
  drizatx_require_command df
  drizatx_require_command sha256sum

  drizatx_load_client_config "$client_key"
  drizatx_validate_client_config

  drizatx_section "CONFIGURACIÓN VALIDADA"
  drizatx_print_client_config

  drizatx_prepare_frontend
}

deploy_client() {
  local client_key="${1:-}"
  local manifest_file="${2:-}"
  local execution_mode="${3:-apply}"

  [ -n "$client_key" ] ||
    drizatx_fail "Debe indicar el cliente"

  [ -n "$manifest_file" ] ||
    drizatx_fail "Debe indicar el manifest exacto"

  drizatx_require_command git
  drizatx_require_command docker
  drizatx_require_command curl
  drizatx_require_command sha256sum

  drizatx_load_client_config "$client_key"
  drizatx_validate_client_config

  drizatx_section "CONFIGURACIÓN VALIDADA"
  drizatx_print_client_config

  case "$execution_mode" in
    apply|dry-run)
      ;;
    *)
      drizatx_fail         "Modo de despliegue inválido: $execution_mode"
      ;;
  esac

  drizatx_deploy_frontend     "$manifest_file"     "$execution_mode"
}

main() {
  local command="${1:-help}"

  case "$command" in
    inspect)
      shift
      inspect_client "${1:-}"
      ;;
    prepare)
      shift
      prepare_client "${1:-}"
      ;;
    deploy)
      shift

      if [ "${1:-}" = "--dry-run" ]; then
        deploy_client           "${2:-}"           "${3:-}"           "dry-run"
      else
        deploy_client           "${1:-}"           "${2:-}"           "apply"
      fi
      ;;
    list)
      list_clients
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      echo
      drizatx_fail "Comando desconocido: $command"
      ;;
  esac
}

main "$@"
